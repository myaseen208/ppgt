result_ct <- pp_decode(M, y, ct = ct_vals, verbose = FALSE)
result_ct
result_ct$positives   # 72 (Ct=24, strong positive)
result_ct$suspected   # 142 (Ct=31 > 29: P(FN) > 0.5, borderline)

